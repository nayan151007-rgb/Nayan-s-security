# GEMINI_API_KEY: Required for server-side Gemini AI vulnerability evaluations.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used by the backend to sign and verify session JWTs.
JWT_SECRET="enterprise_grc_jwt_signing_secret_change_in_prod"
